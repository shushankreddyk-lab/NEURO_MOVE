# NeuroMove Enterprise MI-BCI Platform
# Copy to .env and customize

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# Security
SECRET_KEY=change-this-in-production-neuromove-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (for production)
# DATABASE_URL=postgresql+asyncpg://neuromove:password@postgres:5432/neuromove

# Redis (for caching/sessions)
# REDIS_URL=redis://redis:6379/0

# MLflow (for model registry)
# MLFLOW_TRACKING_URI=http://mlflow:5000

# Model paths
MODEL_DIR=/app/models
NEUROMOVE_ROOT=/app
NEUROMOVE_PIP_PACKAGES=/app/.venv/lib/python3.11/site-packages

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=60
SECRET_KEY=change-this-in-production
ALGORITHM=HS256

# Cloudflare Turnstile (Human Verification)
TURNSTILE_SECRET=your-turnstile-secret-key
REACT_APP_TURNSTILE_SITEKEY=your-turnstile-site-key