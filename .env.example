# NeuroMove Enterprise Configuration
# Copy to .env and customize for your environment

# ========== Application ==========
PROJECT_NAME=NeuroMove Enterprise MI-BCI
VERSION=1.0.0
API_V1_STR=/api/v1

# ========== Security ==========
SECRET_KEY=change-this-to-a-secure-random-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ========== Database (PostgreSQL) ==========
DATABASE_URL=postgresql+asyncpg://neuromove:neuromove@localhost:5432/neuromove

# ========== Cache (Redis) ==========
REDIS_URL=redis://localhost:6379/0

# ========== Message Queue (RabbitMQ) ==========
RABBITMQ_URL=amqp://neuromove:neuromove@localhost:5672/

# ========== Keycloak (Auth) ==========
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=neuromove
KEYCLOAK_CLIENT_ID=neuromove-backend
KEYCLOAK_CLIENT_SECRET=neuromove-backend-secret

# ========== Frontend (React) ==========
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=neuromove
VITE_KEYCLOAK_CLIENT_ID=neuromove-frontend

# ========== Cloudflare Turnstile (Human Verification) ==========
# Get keys from: https://dash.cloudflare.com/
TURNSTILE_SECRET=
REACT_APP_TURNSTILE_SITEKEY=

# ========== Models ==========
MODELS_DIR=/app/models
NEUROMOVE_ROOT=/app