# NeuroMove Enterprise - Environment Configuration
# Copy to .env and customize for your deployment

# =============================================================================
# API Security (REQUIRED - Change in production!)
# =============================================================================
API_KEY_ADMIN=neuromove-enterprise-change-me
API_KEY_CLIENT=neuromove-client-change-me

# =============================================================================
# Database (PostgreSQL for MLflow backend)
# =============================================================================
POSTGRES_PASSWORD=neuromove-secure-postgres-password-change-me

# =============================================================================
# Grafana
# =============================================================================
GRAFANA_PASSWORD=neuromove-secure-grafana-password-change-me

# =============================================================================
# Alerting (Optional - Configure for production)
# =============================================================================
# SMTP for email alerts
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# Slack webhook for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/XXX/XXX

# PagerDuty for critical alerts
PAGERDUTY_KEY=your-pagerduty-integration-key

# =============================================================================
# MLflow (Optional - for remote tracking)
# =============================================================================
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_REGISTRY_URI=http://mlflow:5000

# =============================================================================
# NeuroMove Configuration
# =============================================================================
NEUROMOVE_ROOT=/app
NEUROMOVE_PIP_PACKAGES=
LOG_LEVEL=INFO

# =============================================================================
# Cloudflare Turnstile (Human Verification)
# =============================================================================
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
TURNSTILE_FAIL_OPEN=false